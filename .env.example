# ============================================================
#  Nimzz Code - Environment Variables Template
# ============================================================
# Proyek ini menggunakan file JSON lokal (/data/*.json) sebagai database,
# sehingga Anda TIDAK PERLU setup database eksternal ataupun Firebase!
# Cukup salin file ini menjadi .env.local:
#   cp .env.example .env.local
# ============================================================

# ── 1. DOMAIN WEBSITE ──────────────────────────────────────────
# Gunakan http://localhost:3000 saat development di laptop
# Ganti dengan domain production Anda saat di-deploy (misal: https://nimzz-code.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 2. LOGIN ADMINISTRATOR & KEAMANAN ──────────────────────────
# Username untuk login ke halaman admin (/admin/login)
ADMIN_USERNAME=admin

# Password untuk login admin (bebas tentukan sendiri)
ADMIN_PASSWORD=admin123

# Kunci rahasia untuk enkripsi cookie session admin (bebas acak)
ADMIN_SECRET=nimzz-code-secure-secret-token-key-2026

# Token otorisasi untuk endpoint test internal
INTERNAL_TEST_SECRET=INTERNAL_TEST_BYPASS_TOKEN_2026

# ── 3. NOTIFIKASI TELEGRAM BOT (OPSIONAL) ──────────────────────
# Kosongkan jika belum menggunakan notifikasi bot Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
